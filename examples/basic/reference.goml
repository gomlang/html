        "é" => "é",
        "&amp;&lt;&#39;&#x1f642;" => "&amp;amp;&amp;lt;&amp;#39;&amp;#x1f642;",
        "&&&&" => "&amp;&amp;&amp;&amp;",
        "\r\n\t" => "\r\n\t",
        "x<'界🙂'>&y" => "x&lt;&#39;界🙂&#39;&gt;&amp;y",
        _ => {
            testing::fail("missing fixed entity reference");
            ""
        },
    }
}

