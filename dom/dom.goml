package dom;

use std::utf8;

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    InvalidLimits,
    InputLimit,
    NodeLimit,
    DepthLimit,
    OutputLimit,
    Selector,
    Parse,
    FragmentContext,
    MatchLimit,
    UnstableSanitization,
    SelectorWorkLimit,
}

#[derive(Debug)]
pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

#[derive(Debug)]
pub struct Limits {
    pub max_input_bytes: isize,
    pub max_nodes: isize,
    pub max_depth: isize,
    pub max_output_bytes: isize,
    pub max_selector_bytes: isize,
    pub max_matches: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits {
            max_input_bytes: 1024 * 1024,
            max_nodes: 100000,
            max_depth: 256,
            max_output_bytes: 4 * 1024 * 1024,
            max_selector_bytes: 4096,
            max_matches: 10000,
        }
    }

    fn validate(self: Limits) -> Result[(), Error] {
        if self.max_input_bytes < 0 || self.max_nodes < 1 || self.max_depth < 0
            || self.max_depth > 512
            || self.max_output_bytes < 0
            || self.max_selector_bytes < 0
            || self.max_matches < 0 {
            return Err(
                Error {
                    kind: ErrorKind::InvalidLimits,
                    message: "HTML limits require nonnegative values, nodes >= 1 and depth <= 512",
                },
            )
        }
        Ok(())
    }
}

#[derive(Debug, PartialEq)]
pub enum NodeKind {
    Document,
    Element,
    Text,
    Comment,
    Doctype,
}

#[derive(Debug, PartialEq)]
pub struct Attribute {
    pub namespace: string,
    pub name: string,
    pub value: string,
}

pub struct Node {
    raw: RawNode,
    limits: Limits,
    stats: TreeStats,
}

pub struct Document {
    root: Node,
}

struct TreeStats {
    nodes: isize,
    depth: isize,
    children: isize,
}

fn dom_error(kind: ErrorKind, message: string) -> Error {
    Error { kind, message }
}

fn optional_node(raw: RawNode, node: Node) -> Option[Node] {
    if raw == nil_node() {
        None
    } else {
        Some(Node { raw, limits: node.limits, stats: node.stats })
    }
}

pub fn parse(input: string, limits: Limits) -> Result[Document, Error] {
    parse_document(input, "", limits)
}

pub fn parse_fragment(input: string, context: string, limits: Limits) -> Result[Document, Error] {
    limits.validate()?;
    if input.byte_len() > limits.max_input_bytes {
        return Err(dom_error(ErrorKind::InputLimit, "HTML input byte limit exceeded"))
    }
    if utf8::validate(input.to_bytes().as_slice()).is_err() {
        return Err(dom_error(ErrorKind::Parse, "HTML input is not UTF-8"))
    }
    if !valid_context(context) {
        return Err(
            dom_error(
                ErrorKind::FragmentContext,
                "fragment context must be a recognized lowercase HTML element",
            ),
        )
    }
    parse_document(input, context, limits)
}

fn parse_document(input: string, context: string, limits: Limits) -> Result[Document, Error] {
    limits.validate()?;
    if input.byte_len() > limits.max_input_bytes {
        return Err(dom_error(ErrorKind::InputLimit, "HTML input byte limit exceeded"))
    }
    if utf8::validate(input.to_bytes().as_slice()).is_err() {
        return Err(dom_error(ErrorKind::Parse, "HTML input is not UTF-8"))
    }
    let root = parse_tree(input, context)?;
    let stats = check_tree(root, limits)?;
    Ok(Document { root: Node { raw: root, limits, stats } })
}

fn check_tree(root: RawNode, limits: Limits) -> Result[TreeStats, Error] {
    let mut nodes = 0;
    let mut max_depth = 0;
    let mut max_children = 0;
    let stack = Vec::new();
    stack.push((root, 0));
    while stack.len() > 0 {
        let (node, depth) = stack.get(stack.len() - 1);
        stack.truncate(stack.len() - 1);
        nodes += 1;
        if nodes > limits.max_nodes {
            return Err(dom_error(ErrorKind::NodeLimit, "HTML node limit exceeded"))
        }
        if depth > limits.max_depth {
            return Err(dom_error(ErrorKind::DepthLimit, "HTML tree depth limit exceeded"))
        }
        if depth > max_depth {
            max_depth = depth;
        }
        let mut children = 0;
        let mut child = node_last_child(node);
        while child != nil_node() {
            children += 1;
            stack.push((child, depth + 1));
            child = node_prev_sibling(child);
        }
        if children > max_children {
            max_children = children;
        }
    }
    Ok(TreeStats { nodes, depth: max_depth, children: max_children })
}

impl Document {
    pub fn root(self: Document) -> Node {
        self.root
    }

    pub fn select(self: Document, selector: string) -> Result[Vec[Node], Error] {
        self.root.select(selector)
    }

    pub fn select_first(self: Document, selector: string) -> Result[Option[Node], Error] {
        self.root.select_first(selector)
    }

    pub fn to_html(self: Document) -> Result[string, Error] {
        self.root.outer_html()
    }
}

impl Node {
    pub fn kind(self: Node) -> NodeKind {
        match node_type(self.raw) {
            1 => NodeKind::Text,
            3 => NodeKind::Element,
            4 => NodeKind::Comment,
            5 => NodeKind::Doctype,
            _ => NodeKind::Document,
        }
    }

    pub fn name(self: Node) -> string {
        if self.kind() == NodeKind::Element || self.kind() == NodeKind::Doctype {
            node_data(self.raw)
        } else {
            ""
        }
    }

    pub fn namespace(self: Node) -> string {
        node_namespace(self.raw)
    }

    pub fn value(self: Node) -> string {
        if self.kind() == NodeKind::Text || self.kind() == NodeKind::Comment {
            node_data(self.raw)
        } else {
            ""
        }
    }

    pub fn same_node(self: Node, other: Node) -> bool {
        self.raw == other.raw
    }

    pub fn parent(self: Node) -> Option[Node] {
        optional_node(node_parent(self.raw), self)
    }

    pub fn first_child(self: Node) -> Option[Node] {
        optional_node(node_first_child(self.raw), self)
    }

    pub fn next_sibling(self: Node) -> Option[Node] {
        optional_node(node_next_sibling(self.raw), self)
    }

    pub fn children(self: Node) -> Vec[Node] {
        let result = Vec::new();
        let mut current = self.first_child();
        while let Some(child) = current {
            result.push(child);
            current = child.next_sibling();
        }
        result
    }

    pub fn attributes(self: Node) -> Vec[Attribute] {
        let result = Vec::new();
        for attribute in node_attr(self.raw) {
            result.push(attribute);
        }
        result
    }

    pub fn attribute(self: Node, name: string) -> Option[string] {
        self.attribute_ns("", name)
    }

    pub fn attribute_ns(self: Node, namespace: string, name: string) -> Option[string] {
        for attribute in node_attr(self.raw) {
            if attribute.namespace == namespace && attribute.name == name {
                return Some(attribute.value)
            }
        }
        None
    }

    pub fn text(self: Node) -> Result[string, Error] {
        extract_text(self.raw, self.limits.max_output_bytes)
    }

    pub fn outer_html(self: Node) -> Result[string, Error] {
        render_tree(self.raw, false, self.limits.max_output_bytes)
    }

    pub fn inner_html(self: Node) -> Result[string, Error] {
        render_tree(self.raw, true, self.limits.max_output_bytes)
    }

    pub fn matches(self: Node, selector: string) -> Result[bool, Error] {
        matches_node(self, selector)
    }

    pub fn select(self: Node, selector: string) -> Result[Vec[Node], Error] {
        select_nodes(self, selector, false)
    }

    pub fn select_first(self: Node, selector: string) -> Result[Option[Node], Error] {
        let nodes = select_nodes(self, selector, true)?;
        if nodes.len() == 0 {
            Ok(None)
        } else {
            Ok(Some(nodes.get(0)))
        }
    }
}

#[derive(Debug, PartialEq)]
pub enum SanitizePolicy {
    TextOnly,
    RichText,
}
