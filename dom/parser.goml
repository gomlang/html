package dom;

use std::text;

fn parser_top(p: HtmlParser) -> RawNode {
    {
        let mut n = stack_top(p.oe);
        if (n != nil_node()) {
            return n;
        }
    };
    return p.doc;
}

fn parser_pop_until(p: HtmlParser, s: isize, match_tags: Vec[string]) -> bool {
    {
        let mut i = parser_index_of_element_in_scope(p, s, match_tags);
        if (i != -1) {
            p.oe.truncate(i);
            return true;
        }
    };
    return false;
}

fn parser_index_of_element_in_scope(p: HtmlParser, s: isize, match_tags: Vec[string]) -> isize {
    {
        let mut i = (p.oe.len() - 1);
        while (i >= 0) {
            let mut tag_atom = node_data(p.oe.get(i));
            if (node_namespace(p.oe.get(i)) == "") {
                for t in match_tags {
                    if (t == tag_atom) {
                        return i;
                    }
                }
                match s {
                    0 => {},
                    1 => {
                        if ((tag_atom == "ol") || (tag_atom == "ul")) {
                            return -1;
                        }
                    },
                    2 => {
                        if (tag_atom == "button") {
                            return -1;
                        }
                    },
                    3 => {
                        if (((tag_atom == "html") || (tag_atom == "table"))
                            || (tag_atom == "template")) {
                            return -1;
                        }
                    },
                    _ => {
                        p.failed.set(true);
                    },
                }
            }
            match s {
                0 | 1 | 2 => {
                    if scope_stop_tag(node_namespace(p.oe.get(i)), tag_atom) {
                        return -1;
                    }
                },
                _ => {},
            }
            i = i - 1;
        }
    };
    return -1;
}

fn parser_element_in_scope(p: HtmlParser, s: isize, match_tags: Vec[string]) -> bool {
    return (parser_index_of_element_in_scope(p, s, match_tags) != -1);
}

fn parser_clear_stack_to_context(p: HtmlParser, s: isize) -> () {
    {
        let mut i = (p.oe.len() - 1);
        while (i >= 0) {
            let mut tag_atom = node_data(p.oe.get(i));
            match s {
                3 => {
                    if (((tag_atom == "html") || (tag_atom == "table")) || (tag_atom == "template")) {
                        p.oe.truncate((i + 1));
                        return;
                    }
                },
                4 => {
                    if (((tag_atom == "html") || (tag_atom == "tr")) || (tag_atom == "template")) {
                        p.oe.truncate((i + 1));
                        return;
                    }
                },
                5 => {
                    if (((((tag_atom == "html") || (tag_atom == "tbody")) || (tag_atom == "tfoot"))
                        || (tag_atom == "thead"))
                        || (tag_atom == "template")) {
                        p.oe.truncate((i + 1));
                        return;
                    }
                },
                _ => {
                    p.failed.set(true);
                },
            }
            i = i - 1;
        }
    };
}

fn parser_parse_generic_raw_text_element(p: HtmlParser) -> () {
    parser_add_element(p);
    p.original_im.set(p.im.get());
    p.im.set(28);
}

fn parser_generate_implied_end_tags(p: HtmlParser, exceptions: Vec[string]) -> () {
    let mut i: isize = 0;
    i = (p.oe.len() - 1);
    'loop: while (i >= 0) {
        let mut n = p.oe.get(i);
        if (node_type(n) != 3) {
            break;
        }
        match node_data(n) {
            "dd" | "dt" | "li" | "optgroup" | "option" | "p" | "rb" | "rp" | "rt" | "rtc" => {
                for except in exceptions {
                    if (node_data(n) == except) {
                        break 'loop;
                    }
                }
                i = i - 1;
                continue;
            },
            _ => {},
        }
        break;
    };
    p.oe.truncate((i + 1));
}

fn parser_add_child(p: HtmlParser, n: RawNode) -> () {
    if parser_should_foster_parent(p) {
        parser_foster_parent(p, n);
    } else {
        node_append_child(parser_top(p), n);
    }
    if (node_type(n) == 3) {
        parser_insert_open_element(p, n);
    }
}

fn parser_insert_open_element(p: HtmlParser, n: RawNode) -> () {
    p.oe.push(n);
    if (p.oe.len() > 512) {
        p.failed.set(true);
    }
}

fn parser_should_foster_parent(p: HtmlParser) -> bool {
    if p.foster_parenting.get() {
        match node_data(parser_top(p)) {
            "table" | "tbody" | "tfoot" | "thead" | "tr" => {
                return true;
            },
            _ => {},
        }
    }
    return false;
}

fn parser_foster_parent(p: HtmlParser, n: RawNode) -> () {
    let mut table: RawNode = nil_node();
    let mut parent: RawNode = nil_node();
    let mut prev: RawNode = nil_node();
    let mut template: RawNode = nil_node();
    let mut i: isize = 0;
    i = (p.oe.len() - 1);
    while (i >= 0) {
        if (node_data(p.oe.get(i)) == "table") {
            table = p.oe.get(i);
            break;
        }
        i = i - 1;
    }
    let mut j: isize = 0;
    j = (p.oe.len() - 1);
    while (j >= 0) {
        if (node_data(p.oe.get(j)) == "template") {
            template = p.oe.get(j);
            break;
        }
        j = j - 1;
    }
    if ((template != nil_node()) && (((table == nil_node()) || (j > i)))) {
        node_append_child(template, n);
        return;
    }
    if (table == nil_node()) {
        parent = p.oe.get(0);
    } else {
        parent = node_parent(table);
    }
    if (parent == nil_node()) {
        parent = p.oe.get((i - 1));
    }
    if (table != nil_node()) {
        prev = node_prev_sibling(table);
    } else {
        prev = node_last_child(parent);
    }
    if (((prev != nil_node()) && (node_type(prev) == 1)) && (node_type(n) == 1)) {
        set_node_data(prev, node_data(prev) + node_data(n));
        return;
    }
    node_insert_before(parent, n, table);
}

fn parser_add_text(p: HtmlParser, text: string) -> () {
    if (text == "") {
        return;
    }
    if parser_should_foster_parent(p) {
        parser_foster_parent(p, new_node(1, text, "", Vec::new()));
        return;
    }
    let mut t = parser_top(p);
    {
        let mut n = node_last_child(t);
        if ((n != nil_node()) && (node_type(n) == 1)) {
            set_node_data(n, node_data(n) + text);
            return;
        }
    };
    parser_add_child(p, new_node(1, text, "", Vec::new()));
}

fn parser_add_element(p: HtmlParser) -> () {
    parser_add_child(p, new_node(3, p.tok.get().data, "", p.tok.get().attr));
}

fn parser_add_formatting_element(p: HtmlParser) -> () {
    let mut tag_atom = p.tok.get().data;
    let mut attr = p.tok.get().attr;
    parser_add_element(p);
    sort_attributes(attr);
    let mut identical_elements = 0;
    {
        let mut i = (p.afe.len() - 1);
        'find_identical_elements: while (i >= 0) {
            let mut n = p.afe.get(i);
            if (node_type(n) == 7) {
                break;
            }
            if (node_type(n) != 3) {
                i = i - 1;
                continue;
            }
            if (node_namespace(n) != "") {
                i = i - 1;
                continue;
            }
            if (node_data(n) != tag_atom) {
                i = i - 1;
                continue;
            }
            if !attributes_equal(node_attr(n), attr) {
                i = i - 1;
                continue 'find_identical_elements;
            }
            identical_elements = identical_elements + 1;
            if (identical_elements >= 3) {
                stack_remove(p.afe, n);
            }
            i = i - 1;
        };
    };
    let mut top = parser_top(p);
    sort_attributes(node_attr(top));
    p.afe.push(top);
}

fn parser_clear_active_formatting_elements(p: HtmlParser) -> () {
    while true {
        {
            let mut n = stack_pop(p.afe);
            if ((p.afe.len() == 0) || (node_type(n) == 7)) {
                return;
            }
        };
    }
}

fn parser_reconstruct_active_formatting_elements(p: HtmlParser) -> () {
    let mut n = stack_top(p.afe);
    if (n == nil_node()) {
        return;
    }
    if ((node_type(n) == 7) || (stack_index(p.oe, n) != -1)) {
        return;
    }
    let mut i = (p.afe.len() - 1);
    while ((node_type(n) != 7) && (stack_index(p.oe, n) == -1)) {
        if (i == 0) {
            i = -1;
            break;
        }
        i = i - 1;
        n = p.afe.get(i);
    }
    while true {
        i = i + 1;
        let mut clone = node_clone(p.afe.get(i));
        parser_add_child(p, clone);
        p.afe.set(i, clone);
        if (i == (p.afe.len() - 1)) {
            break;
        }
    }
}

fn parser_acknowledge_self_closing_tag(p: HtmlParser) -> () {
    p.has_self_closing_token.set(false);
}

fn parser_set_original_im(p: HtmlParser) -> () {
    if (p.original_im.get() != -1) {
        p.failed.set(true);
    }
    p.original_im.set(p.im.get());
}

fn parser_reset_insertion_mode(p: HtmlParser) -> () {
    {
        let mut i = (p.oe.len() - 1);
        while (i >= 0) {
            let mut n = p.oe.get(i);
            let mut last = (i == 0);
            if (last && (p.context != nil_node())) {
                n = p.context;
            }
            match node_data(n) {
                "td" | "th" => {
                    p.im.set(34);
                },
                "tr" => {
                    p.im.set(33);
                },
                "tbody" | "thead" | "tfoot" => {
                    p.im.set(32);
                },
                "caption" => {
                    p.im.set(30);
                },
                "colgroup" => {
                    p.im.set(31);
                },
                "table" => {
                    p.im.set(29);
                },
                "template" => {
                    if (node_namespace(n) != "") {
                        i = i - 1;
                        continue;
                    }
                    p.im.set(mode_top(p.template_stack));
                },
                "head" => {
                    p.im.set(22);
                },
                "body" => {
                    p.im.set(25);
                },
                "frameset" => {
                    p.im.set(37);
                },
                "html" => {
                    if (p.head.get() == nil_node()) {
                        p.im.set(21);
                    } else {
                        p.im.set(24);
                    }
                },
                _ => {
                    if last {
                        p.im.set(25);
                        return;
                    }
                    i = i - 1;
                    continue;
                },
            }
            return;
        }
    };
}

fn initial_im(p: HtmlParser) -> bool {
    match p.tok.get().typ {
        1 => {
            p.tok.set(
                HtmlToken {
                    data: text::trim_start_chars(p.tok.get().data, " \t\r\n\u000c"),
                    ..p.tok.get(),
                },
            );
            if (p.tok.get().data.byte_len() == 0) {
                return true;
            }
        },
        5 => {
            node_append_child(p.doc, new_node(4, p.tok.get().data, "", Vec::new()));
            return true;
        },
        6 => {
            let mut(n, quirks) = parser_doctype(p.tok.get().data);
            node_append_child(p.doc, n);
            p.quirks.set(quirks);
            p.im.set(20);
            return true;
        },
        _ => {},
    }
    p.quirks.set(true);
    p.im.set(20);
    return false;
}

fn before_htmlim(p: HtmlParser) -> bool {
    match p.tok.get().typ {
        6 => {
            return true;
        },
        1 => {
            p.tok.set(
                HtmlToken {
                    data: text::trim_start_chars(p.tok.get().data, " \t\r\n\u000c"),
                    ..p.tok.get(),
                },
            );
            if (p.tok.get().data.byte_len() == 0) {
                return true;
            }
        },
        2 => {
            if (p.tok.get().data == "html") {
                parser_add_element(p);
                p.im.set(21);
                return true;
            }
        },
        3 => {
            match p.tok.get().data {
                "head" | "body" | "html" | "br" => {
                    parser_parse_implied_token(p, 2, "html", "html");
                    return false;
                },
                _ => {
                    return true;
                },
            }
        },
        5 => {
            node_append_child(p.doc, new_node(4, p.tok.get().data, "", Vec::new()));
            return true;
        },
        _ => {},
    }
    parser_parse_implied_token(p, 2, "html", "html");
    return false;
}

fn before_head_im(p: HtmlParser) -> bool {
    match p.tok.get().typ {
        1 => {
            p.tok.set(
                HtmlToken {
                    data: text::trim_start_chars(p.tok.get().data, " \t\r\n\u000c"),
                    ..p.tok.get(),
                },
            );
            if (p.tok.get().data.byte_len() == 0) {
                return true;
            }
        },
        2 => {
            match p.tok.get().data {
                "head" => {
                    parser_add_element(p);
                    p.head.set(parser_top(p));
                    p.im.set(22);
                    return true;
                },
                "html" => {
                    return in_body_im(p);
                },
                _ => {},
            }
        },
        3 => {
            match p.tok.get().data {
                "head" | "body" | "html" | "br" => {
                    parser_parse_implied_token(p, 2, "head", "head");
                    return false;
                },
                _ => {
                    return true;
                },
            }
        },
        5 => {
            parser_add_child(p, new_node(4, p.tok.get().data, "", Vec::new()));
            return true;
        },
        6 => {
            return true;
        },
        _ => {},
    }
    parser_parse_implied_token(p, 2, "head", "head");
    return false;
}

fn in_head_im(p: HtmlParser) -> bool {
    match p.tok.get().typ {
        1 => {
            let mut s = text::trim_start_chars(p.tok.get().data, " \t\r\n\u000c");
            if (s.byte_len() < p.tok.get().data.byte_len()) {
                parser_add_text(
                    p,
                    p.tok.get().data.byte_slice(0, (p.tok.get().data.byte_len() - s.byte_len())),
                );
                if (s == "") {
                    return true;
                }
                p.tok.set(HtmlToken { data: s, ..p.tok.get() });
            }
        },
        2 => {
            match p.tok.get().data {
                "html" => {
                    return in_body_im(p);
                },
                "base" | "basefont" | "bgsound" | "link" | "meta" => {
                    parser_add_element(p);
                    stack_pop(p.oe);
                    parser_acknowledge_self_closing_tag(p);
                    return true;
                },
                "noscript" => {
                    if p.scripting {
                        parser_parse_generic_raw_text_element(p);
                        return true;
                    }
                    parser_add_element(p);
                    p.im.set(23);
                    tokenizer_next_is_not_raw_text(p.tokenizer);
                    return true;
                },
                "script" | "title" => {
                    parser_add_element(p);
                    parser_set_original_im(p);
                    p.im.set(28);
                    return true;
                },
                "noframes" | "style" => {
                    parser_parse_generic_raw_text_element(p);
                    return true;
                },
                "head" => {
                    return true;
                },
                "template" => {
                    for e in p.oe {
                        if (node_namespace(e) != "") {
                            p.im.set(41);
                            return true;
                        }
                    }
                    parser_add_element(p);
                    p.afe.push(new_node(7, "", "", Vec::new()));
                    p.frameset_ok.set(false);
                    p.im.set(35);
                    p.template_stack.push(35);
                    return true;
                },
                _ => {},
            }
        },
        3 => {
            match p.tok.get().data {
                "head" => {
                    stack_pop(p.oe);
                    p.im.set(24);
                    return true;
                },
                "body" | "html" | "br" => {
                    parser_parse_implied_token(p, 3, "head", "head");
                    return false;
                },
                "template" => {
                    if !stack_contains(p.oe, "template") {
                        return true;
                    }
                    parser_generate_implied_end_tags(
                        p,
                        {
                            let v = Vec::new();
                            v
                        },
                    );
                    {
                        let mut i = (p.oe.len() - 1);
                        while (i >= 0) {
                            {
                                let mut n = p.oe.get(i);
                                if ((node_namespace(n) == "") && (node_data(n) == "template")) {
                                    p.oe.truncate(i);
                                    break;
                                }
                            };
                            i = i - 1;
                        }
                    };
                    parser_clear_active_formatting_elements(p);
                    mode_pop(p.template_stack);
                    parser_reset_insertion_mode(p);
                    return true;
                },
                _ => {
                    return true;
                },
            }
        },
        5 => {
            parser_add_child(p, new_node(4, p.tok.get().data, "", Vec::new()));
            return true;
        },
        6 => {
            return true;
        },
        _ => {},
    }
    parser_parse_implied_token(p, 3, "head", "head");
    return false;
}

fn in_head_noscript_im(p: HtmlParser) -> bool {
    match p.tok.get().typ {
        6 => {
            return true;
        },
        2 => {
            match p.tok.get().data {
                "html" => {
                    return in_body_im(p);
                },
                "basefont" | "bgsound" | "link" | "meta" | "noframes" | "style" => {
                    return in_head_im(p);
                },
                "head" => {
                    return true;
                },
                "noscript" => {
                    tokenizer_next_is_not_raw_text(p.tokenizer);
                    return true;
                },
                _ => {},
            }
        },
        3 => {
            match p.tok.get().data {
                "noscript" | "br" => {},
                _ => {
                    return true;
                },
            }
        },
        1 => {
            let mut s = text::trim_start_chars(p.tok.get().data, " \t\r\n\u000c");
            if (s.byte_len() == 0) {
                return in_head_im(p);
            }
        },
        5 => {
            return in_head_im(p);
        },
        _ => {},
    }
    stack_pop(p.oe);
    if (node_data(parser_top(p)) != "head") {
        p.failed.set(true);
    }
    p.im.set(22);
    if (p.tok.get().data == "noscript") {
        return true;
    }
    return false;
}

fn after_head_im(p: HtmlParser) -> bool {
    match p.tok.get().typ {
        1 => {
            let mut s = text::trim_start_chars(p.tok.get().data, " \t\r\n\u000c");
            if (s.byte_len() < p.tok.get().data.byte_len()) {
                parser_add_text(
                    p,
                    p.tok.get().data.byte_slice(0, (p.tok.get().data.byte_len() - s.byte_len())),
                );
                if (s == "") {
                    return true;
                }
                p.tok.set(HtmlToken { data: s, ..p.tok.get() });
            }
        },
        2 => {
            match p.tok.get().data {
                "html" => {
                    return in_body_im(p);
                },
                "body" => {
                    parser_add_element(p);
                    p.frameset_ok.set(false);
                    p.im.set(25);
                    return true;
                },
                "frameset" => {
                    parser_add_element(p);
                    p.im.set(37);
                    return true;
                },
                "base" | "basefont" | "bgsound" | "link" | "meta" | "noframes" | "script" | "style" | "template" | "title" => {
                    parser_insert_open_element(p, p.head.get());
                    defer stack_remove(p.oe, p.head.get());
                    return in_head_im(p);
                },
                "head" => {
                    return true;
                },
                _ => {},
            }
        },
        3 => {
            match p.tok.get().data {
                "body" | "html" | "br" => {},
                "template" => {
                    return in_head_im(p);
                },
                _ => {
                    return true;
                },
            }
        },
        5 => {
            parser_add_child(p, new_node(4, p.tok.get().data, "", Vec::new()));
            return true;
        },
        6 => {
            return true;
        },
        _ => {},
    }
    parser_parse_implied_token(p, 2, "body", "body");
    p.frameset_ok.set(true);
    if (p.tok.get().typ == 0) {
        return true;
    }
    return false;
}

fn in_body_im(p: HtmlParser) -> bool {
    match p.tok.get().typ {
        1 => {
            let mut d = p.tok.get().data;
            {
                let mut n = stack_top(p.oe);
                match node_data(n) {
                    "pre" | "listing" => {
                        if (node_first_child(n) == nil_node()) {
                            if ((d != "") && (d.byte_get(0) == b'\r')) {
                                d = d.byte_slice(1, d.byte_len());
                            }
                            if ((d != "") && (d.byte_get(0) == b'\n')) {
                                d = d.byte_slice(1, d.byte_len());
                            }
                        }
                    },
                    _ => {},
                }
            };
            d = text::replace(d, "\u0000", "");
            if (d == "") {
                return true;
            }
            parser_reconstruct_active_formatting_elements(p);
            parser_add_text(p, d);
            if (p.frameset_ok.get() && (text::trim_start_chars(d, " \t\r\n\u000c") != "")) {
                p.frameset_ok.set(false);
            }
        },
        2 => {
            match p.tok.get().data {
                "html" => {
                    if stack_contains(p.oe, "template") {
                        return true;
                    }
                    copy_attributes(p.oe.get(0), p.tok.get());
                },
                "base" | "basefont" | "bgsound" | "link" | "meta" | "noframes" | "script" | "style" | "template" | "title" => {
                    return in_head_im(p);
                },
                "body" => {
                    if stack_contains(p.oe, "template") {
                        return true;
                    }
                    if (p.oe.len() >= 2) {
                        let mut body = p.oe.get(1);
                        if ((node_type(body) == 3) && (node_data(body) == "body")) {
                            p.frameset_ok.set(false);
                            copy_attributes(body, p.tok.get());
                        }
                    }
                },
                "frameset" => {
                    if ((!p.frameset_ok.get() || (p.oe.len() < 2))
                        || (node_data(p.oe.get(1)) != "body")) {
                        return true;
                    }
                    let mut body = p.oe.get(1);
                    if (node_parent(body) != nil_node()) {
                        node_remove_child(node_parent(body), body);
                    }
                    p.oe.truncate(1);
                    parser_add_element(p);
                    p.im.set(37);
                    return true;
                },
                "address" | "article" | "aside" | "blockquote" | "center" | "details" | "dialog" | "dir" | "div" | "dl" | "fieldset" | "figcaption" | "figure" | "footer" | "header" | "hgroup" | "main" | "menu" | "nav" | "ol" | "p" | "search" | "section" | "summary" | "ul" => {
                    parser_pop_until(
                        p,
                        2,
                        {
                            let v = Vec::new();
                            v.push("p");
                            v
                        },
                    );
                    parser_add_element(p);
                },
                "h1" | "h2" | "h3" | "h4" | "h5" | "h6" => {
                    parser_pop_until(
                        p,
                        2,
                        {
                            let v = Vec::new();
                            v.push("p");
                            v
                        },
                    );
                    {
                        let mut n = parser_top(p);
                        match node_data(n) {
                            "h1" | "h2" | "h3" | "h4" | "h5" | "h6" => {
                                stack_pop(p.oe);
                            },
                            _ => {},
                        }
                    };
                    parser_add_element(p);
                },
                "pre" | "listing" => {
                    parser_pop_until(
                        p,
                        2,
                        {
                            let v = Vec::new();
                            v.push("p");
                            v
                        },
                    );
                    parser_add_element(p);
                    p.frameset_ok.set(false);
                },
                "form" => {
                    if ((p.form.get() != nil_node()) && !stack_contains(p.oe, "template")) {
                        return true;
                    }
                    parser_pop_until(
                        p,
                        2,
                        {
                            let v = Vec::new();
                            v.push("p");
                            v
                        },
                    );
                    parser_add_element(p);
                    if !stack_contains(p.oe, "template") {
                        p.form.set(parser_top(p));
                    }
                },
                "li" => {
                    p.frameset_ok.set(false);
                    {
                        let mut i = (p.oe.len() - 1);
                        while (i >= 0) {
                            let mut node = p.oe.get(i);
                            match node_data(node) {
                                "li" => {
                                    p.oe.truncate(i);
                                },
                                "address" | "div" | "p" => {
                                    i = i - 1;
                                    continue;
                                },
                                _ => {
                                    if !is_special_element(node) {
                                        i = i - 1;
                                        continue;
                                    }
                                },
                            }
                            break;
                        }
                    };
                    parser_pop_until(
                        p,
                        2,
                        {
                            let v = Vec::new();
                            v.push("p");
                            v
                        },
                    );
                    parser_add_element(p);
                },
                "dd" | "dt" => {
                    p.frameset_ok.set(false);
                    {
                        let mut i = (p.oe.len() - 1);
                        while (i >= 0) {
                            let mut node = p.oe.get(i);
                            match node_data(node) {
                                "dd" | "dt" => {
                                    p.oe.truncate(i);
                                },
                                "address" | "div" | "p" => {
                                    i = i - 1;
                                    continue;
                                },
                                _ => {
                                    if !is_special_element(node) {
                                        i = i - 1;
                                        continue;
                                    }
