                            v.push("p");
                            v
                        },
                    );
                    parser_add_element(p);
                },
                "plaintext" => {
                    parser_pop_until(
                        p,
                        2,
                        {
                            let v = Vec::new();
                            v.push("p");
                            v
                        },
                    );
                    parser_add_element(p);
                },
                "button" => {
                    if parser_element_in_scope(
                        p,
                        0,
                        {
                            let v = Vec::new();
                            v.push("button");
                            v
                        },
                    ) {
                        parser_generate_implied_end_tags(
                            p,
                            {
                                let v = Vec::new();
                                v
                            },
                        );
                        parser_pop_until(
                            p,
                            0,
                            {
                                let v = Vec::new();
                                v.push("button");
                                v
                            },
                        );
                    }
                    parser_reconstruct_active_formatting_elements(p);
                    parser_add_element(p);
                    p.frameset_ok.set(false);
                },
                "a" => {
                    {
                        let mut i = (p.afe.len() - 1);
                        while ((i >= 0) && (node_type(p.afe.get(i)) != 7)) {
                            {
                                let mut n = p.afe.get(i);
                                if ((node_type(n) == 3) && (node_data(n) == "a")) {
                                    parser_in_body_end_tag_formatting(p, "a", "a");
                                    stack_remove(p.oe, n);
                                    stack_remove(p.afe, n);
                                    break;
                                }
                            };
                            i = i - 1;
                        }
                    };
                    parser_reconstruct_active_formatting_elements(p);
                    parser_add_formatting_element(p);
                },
                "b" | "big" | "code" | "em" | "font" | "i" | "s" | "small" | "strike" | "strong" | "tt" | "u" => {
                    parser_reconstruct_active_formatting_elements(p);
                    parser_add_formatting_element(p);
                },
                "nobr" => {
                    parser_reconstruct_active_formatting_elements(p);
                    if parser_element_in_scope(
                        p,
                        0,
                        {
                            let v = Vec::new();
                            v.push("nobr");
                            v
